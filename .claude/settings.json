{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(npm run test:browser)",
      "Bash(npm run test:browser *)",
      "Bash(npx playwright test *)",
      "Bash(npx knip *)",
      "Bash(npx depcheck *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch -c *)",
      "Bash(git switch --create *)",
      "Bash(gh pr create *)",
      "Bash(gh run rerun *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(git reset * --hard*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf *..*)",
      "Bash(rm -rf *.git*)",
      "Bash(rm -rf *.claude*)",
      "Bash(rm -rf *src*)",
      "Bash(rm -rf *tests*)",
      "Bash(rm -rf *public*)",
      "Bash(rm -rf *docs*)",
      "Bash(rm -rf *scripts*)",
      "Bash(rm -rf *node_modules*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -fr $*)",
      "Bash(rm -fr .)",
      "Bash(rm -fr ./)",
      "Bash(rm -fr *..*)",
      "Bash(rm -fr *.git*)",
      "Bash(rm -fr *.claude*)",
      "Bash(rm -fr *src*)",
      "Bash(rm -fr *tests*)",
      "Bash(rm -fr *public*)",
      "Bash(rm -fr *docs*)",
      "Bash(rm -fr *scripts*)",
      "Bash(rm -fr *node_modules*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
